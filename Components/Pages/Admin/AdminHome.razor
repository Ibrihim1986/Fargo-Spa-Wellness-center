@page "/admin"
@layout Family_and_Spa_Wellness.Components.Layout.AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject AppDbContext Db
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims
@using System.Text.Json

<PageTitle>Admin - Fargo Spa and Wellness</PageTitle>

<h1>Admin Dashboard</h1>
<p class="text-sage">Manage services, staff, promotions, and view business insights.</p>

<ul class="nav admin-tabs mb-4">
    <li class="nav-item">
        <button class="admin-tab @(activeTab == "overview" ? "active" : "")" @onclick='() => activeTab = "overview"'>Overview</button>
    </li>
    <li class="nav-item">
        <button class="admin-tab @(activeTab == "services" ? "active" : "")" @onclick='() => activeTab = "services"'>Services</button>
    </li>
    <li class="nav-item">
        <button class="admin-tab @(activeTab == "staff" ? "active" : "")" @onclick='() => activeTab = "staff"'>Staff</button>
    </li>
    <li class="nav-item">
        <button class="admin-tab @(activeTab == "promotions" ? "active" : "")" @onclick='() => activeTab = "promotions"'>Promotions</button>
    </li>
</ul>

@if (activeTab == "overview")
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="stat-icon">📅</div>
                    <div class="stat-value">@todaysBookings</div>
                    <div class="stat-label">Today's Bookings</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="stat-icon">💵</div>
                    <div class="stat-value">@estimatedRevenue.ToString("C0")</div>
                    <div class="stat-label">Revenue (est.)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="stat-icon">👥</div>
                    <div class="stat-value">@totalClients</div>
                    <div class="stat-label">Total Clients</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-value stat-value-sm">@topService</div>
                    <div class="stat-label">Top Service</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Bookings by Week</h5>
                    <div class="bar-chart">
                        @foreach (var week in bookingsByWeek)
                        {
                            <div class="bar-col">
                                <div class="bar" style="height:@(week.Count == 0 ? 2 : week.Count * 100 / maxWeekCount)%"></div>
                                <div class="bar-label">@week.Label</div>
                                <div class="bar-value">@week.Count</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5>Revenue by Service Category</h5>
                    <div class="d-flex align-items-center gap-4 flex-wrap">
                        <div class="pie-chart" style="background:@pieGradient"></div>
                        <ul class="pie-legend">
                            @foreach (var slice in revenueByCategory)
                            {
                                <li>
                                    <span class="legend-swatch" style="background-color:@slice.Color"></span>
                                    @slice.Category — @slice.Amount.ToString("C0")
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (activeTab == "services")
{
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0">Service Catalog (admin)</h4>
        <button class="btn btn-primary" @onclick="StartAdd">Add Service</button>
    </div>

    @if (showForm && editService is not null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <EditForm Model="editService" OnValidSubmit="SaveService">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="editService.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <InputText class="form-control" @bind-Value="editService.Category" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="editService.Description" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duration (min)</label>
                            <InputNumber class="form-control" @bind-Value="editService.DurationMinutes" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Price</label>
                            <InputNumber class="form-control" @bind-Value="editService.Price" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="editService.IsActive" id="isActive" />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-success" type="submit">Save</button>
                            <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="row g-3">
        @foreach (var service in services)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="mb-0">@service.Name</h6>
                                @if (!service.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </div>
                            <p class="text-sage mb-1">@service.Category — @service.DurationMinutes min</p>
                            <p class="mb-2">@service.Description</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div class="fw-bold text-teal">
                                @(service.Price > 0 ? service.Price.ToString("C") : "Contact for pricing")
                            </div>
                            <div>
                                <a class="btn btn-sm btn-outline-secondary me-2" href="/admin/services/pricing/@service.Id">Manage Pricing</a>
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Edit(service)">Edit</button>
                                <button class="btn btn-sm @(service.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleActive(service)">@(service.IsActive ? "Deactivate" : "Activate")</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pricing management is available on a separate page: /admin/services/pricing/{id} -->
}
else if (activeTab == "staff")
{
    <div class="row g-3">
        @foreach (var provider in staff)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6>@provider.FullName</h6>
                        <p class="text-sage mb-1">@provider.Title</p>
                        <p class="mb-0 small">@provider.Bio</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (activeTab == "promotions")
{
    <p>Coming soon: create and manage promotional offers.</p>
}

@code {
    private string activeTab = "overview";

    private int todaysBookings;
    private decimal estimatedRevenue;
    private int totalClients;
    private string topService = "—";

    private List<WeekBucket> bookingsByWeek = [];
    private int maxWeekCount = 1;

    private List<CategorySlice> revenueByCategory = [];
    private string pieGradient = "";

    private List<Service> services = [];
    private List<User> staff = [];
    private bool showForm = false;
    private Service? editService;

    private bool showForm = false;
    private Service? editService;
    // Pricing management moved to dedicated admin page (/admin/services/pricing/{id})

    private static readonly string[] ChartPalette = ["#2E7D6B", "#7C9885", "#C9AE80", "#4a6b60", "#a3b8a9", "#8a765a"];

    protected override async Task OnInitializedAsync()
    {
        services = await Db.Services.ToListAsync();
        staff = await Db.Users.Where(u => u.Role == "Provider").ToListAsync();

        var appointments = await Db.Appointments.ToListAsync();
        var serviceById = services.ToDictionary(s => s.Id);
        var allServices = await Db.Services.ToDictionaryAsync(s => s.Id);

        todaysBookings = appointments.Count(a => a.StartTime.Date == DateTime.Today);
        totalClients = await Db.Users.CountAsync(u => u.Role == "Client");

        estimatedRevenue = appointments
            .Where(a => a.Status == "Completed" && allServices.TryGetValue(a.ServiceId, out _))
            .Sum(a => allServices[a.ServiceId].Price);

        topService = appointments
            .Where(a => allServices.ContainsKey(a.ServiceId))
            .GroupBy(a => allServices[a.ServiceId].Name)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefault() ?? "—";

        bookingsByWeek = appointments
            .GroupBy(a => System.Globalization.ISOWeek.GetWeekOfYear(a.StartTime))
            .OrderBy(g => g.Key)
            .Select(g => new WeekBucket($"Wk {g.Key}", g.Count()))
            .ToList();
        maxWeekCount = bookingsByWeek.Count > 0 ? Math.Max(1, bookingsByWeek.Max(w => w.Count)) : 1;

        var revenueGroups = appointments
            .Where(a => a.Status == "Completed" && allServices.ContainsKey(a.ServiceId))
            .GroupBy(a => allServices[a.ServiceId].Category)
            .Select(g => new { Category = g.Key, Amount = g.Sum(a => allServices[a.ServiceId].Price) })
            .Where(g => g.Amount > 0)
            .OrderByDescending(g => g.Amount)
            .ToList();

        var totalRevenue = revenueGroups.Sum(g => g.Amount);
        revenueByCategory = [];
        var cumulative = 0m;
        var gradientStops = new List<string>();

        for (var i = 0; i < revenueGroups.Count; i++)
        {
            var group = revenueGroups[i];
            var color = ChartPalette[i % ChartPalette.Length];
            revenueByCategory.Add(new CategorySlice(group.Category, group.Amount, color));

            if (totalRevenue > 0)
            {
                var startPct = cumulative / totalRevenue * 100;
                cumulative += group.Amount;
                var endPct = cumulative / totalRevenue * 100;
                gradientStops.Add($"{color} {startPct:0.##}% {endPct:0.##}%");
            }
        }

        pieGradient = gradientStops.Count > 0
            ? $"conic-gradient({string.Join(", ", gradientStops)})"
            : "#F5EFE6";
    }

    private void StartAdd()
    {
        editService = new Service { IsActive = true };
        showForm = true;
    }



    private void Edit(Service svc)
    {
        // Make a shallow copy to edit without mutating list until saved
        editService = new Service
        {
            Id = svc.Id,
            Name = svc.Name,
            Category = svc.Category,
            Description = svc.Description,
            DurationMinutes = svc.DurationMinutes,
            Price = svc.Price,
            IsActive = svc.IsActive
        };
        showForm = true;
    }

    private async Task SaveService()
    {
        if (editService == null)
            return;

        if (string.IsNullOrWhiteSpace(editService.Name))
            return;

        if (editService.Id == 0)
        {
            Db.Services.Add(editService);
        }
        else
        {
            var dbSvc = await Db.Services.FindAsync(editService.Id);
            if (dbSvc is null)
                return;

            dbSvc.Name = editService.Name;
            dbSvc.Category = editService.Category;
            dbSvc.Description = editService.Description;
            dbSvc.DurationMinutes = editService.DurationMinutes;
            dbSvc.Price = editService.Price;
            dbSvc.IsActive = editService.IsActive;
        }

        await Db.SaveChangesAsync();
        services = await Db.Services.ToListAsync();
        showForm = false;
        editService = null;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        showForm = false;
        editService = null;
    }

    private async Task ToggleActive(Service svc)
    {
        var dbSvc = await Db.Services.FindAsync(svc.Id);
        if (dbSvc is null)
            return;

        dbSvc.IsActive = !dbSvc.IsActive;
        await Db.SaveChangesAsync();
        services = await Db.Services.ToListAsync();
        StateHasChanged();
    }

    // Pricing methods
    // Pricing methods moved to Components/Pages/Admin/ServicePricing.razor

    private record WeekBucket(string Label, int Count);
    private record CategorySlice(string Category, decimal Amount, string Color);

    private async Task SaveService()
    {
        if (editService == null)
            return;

        if (string.IsNullOrWhiteSpace(editService.Name))
            return;

        // Create approval request instead of applying immediately
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var requesterId = int.Parse(user.FindFirst(ClaimTypes.NameIdentifier)!.Value);
        var requesterEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "";

        var payload = JsonSerializer.Serialize(editService);
        var req = new ApprovalRequest
        {
            EntityType = "Service",
            Action = editService.Id == 0 ? "Create" : "Update",
            EntityId = editService.Id == 0 ? null : editService.Id,
            Payload = payload,
            RequestedById = requesterId,
            RequestedByEmail = requesterEmail,
            RequestedAt = DateTime.UtcNow,
            Status = "Pending"
        };

        Db.ApprovalRequests.Add(req);
        await Db.SaveChangesAsync();

        // Refresh services list to show submitted state; do not apply change until approval
        services = await Db.Services.ToListAsync();
        showForm = false;
        editService = null;
        StateHasChanged();
    }

}
