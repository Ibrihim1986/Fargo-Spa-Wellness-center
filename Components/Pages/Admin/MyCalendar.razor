@page "/admin/my-calendar"
@layout Family_and_Spa_Wellness.Components.Layout.AdminLayout
@attribute [Authorize(Roles = "Provider")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<!-- US-401, US-501, US-601: provider daily/weekly schedule view -->
<PageTitle>My Calendar - Fargo Spa and Wellness</PageTitle>

<h1>My Calendar</h1>

@if (provider is null)
{
    <p>Loading...</p>
}
else
{
    RenderFragment<BookingRow> AppointmentCard = row => @<div class="card">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="booking-time">
                <div class="fw-semibold">@row.Appointment.StartTime.ToString("MMM d, h:mm tt")</div>
                <span class="status-badge">@row.Appointment.Status</span>
            </div>
            <div class="flex-grow-1">
                <div class="fw-semibold">@row.Client?.FullName</div>
                <div class="text-sage small">@row.Service?.Name — @row.Client?.Phone</div>
                @if (missingWaiverAppointmentIds.Contains(row.Appointment.Id))
                {
                    <!-- US-405: alert if a client hasn't completed a required waiver -->
                    <span class="badge-featured mt-1 d-inline-block">⚠ Waiver not on file</span>
                }
                @if (row.Client is not null && healthFlagsByClient.TryGetValue(row.Client.Id, out var flags))
                {
                    <!-- US-503: flag health conditions relevant to a treatment -->
                    @foreach (var flag in flags)
                    {
                        <span class="badge-featured mt-1 d-inline-block" title="@flag.Details">⚠ @flag.FlagType</span>
                    }
                }
            </div>
            <div class="d-flex gap-2">
                @if (row.Appointment.Status is "Upcoming" or "CheckedIn")
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => CompleteAppointment(row.Appointment)">Complete</button>
                }
                @if (row.Client is not null)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@NoteLink(row)">Notes</a>
                }
            </div>
        </div>
    </div>;

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="btn-group" role="group">
            <button class="btn btn-sm @(viewMode == "Day" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetViewMode("Day")'>Day</button>
            <button class="btn btn-sm @(viewMode == "Week" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetViewMode("Week")'>Week</button>
        </div>
        <div class="btn-group" role="group">
            <button class="btn btn-sm btn-outline-secondary" @onclick="GoToPrevious">‹ Prev</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="GoToToday">Today</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="GoToNext">Next ›</button>
        </div>
        <span class="fw-semibold ms-2">
            @(viewMode == "Day" ? selectedDate.ToString("dddd, MMM d, yyyy") : $"Week of {WeekStart:MMM d} – {WeekStart.AddDays(6):MMM d, yyyy}")
        </span>
    </div>

    @if (viewMode == "Day")
    {
        <div class="d-flex flex-column gap-2 mb-5">
            @if (!DaySchedule(selectedDate).Any())
            {
                <p class="text-sage">No appointments on this day.</p>
            }
            @foreach (var row in DaySchedule(selectedDate))
            {
                @AppointmentCard(row)
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4 mb-5">
            @for (var i = 0; i < 7; i++)
            {
                var day = WeekStart.AddDays(i);
                <div>
                    <h2 class="h6">@day.ToString("dddd, MMM d")</h2>
                    @if (!DaySchedule(day).Any())
                    {
                        <p class="text-sage small">No appointments.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var row in DaySchedule(day))
                            {
                                @AppointmentCard(row)
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- US-402: block off unavailable times -->
    <h2>My Availability — @availabilityDate.ToString("dddd, MMM d")</h2>
    <p class="text-sage">Toggle time blocks to mark yourself unavailable on this day. Booked times are shown for reference.</p>

    <div class="d-flex flex-wrap gap-2 mt-3">
        @foreach (var hour in AvailabilityHours)
        {
            var isBooked = bookedHoursForDay.Contains(hour);
            var isUnavailable = unavailableHoursForDay.Contains(hour);
            <button class="btn slot-btn @(isBooked ? "slot-booked" : isUnavailable ? "slot-unavailable" : "slot-available")"
                    disabled="@isBooked"
                    @onclick="() => ToggleAvailability(hour)">
                @FormatHour(hour)
                <div class="slot-state">@(isBooked ? "Booked" : isUnavailable ? "Unavailable" : "Available")</div>
            </button>
        }
    </div>
}

@code {
    private User? provider;
    private List<BookingRow> weekAppointments = [];
    private HashSet<int> missingWaiverAppointmentIds = [];
    private Dictionary<int, List<ClientHealthFlag>> healthFlagsByClient = [];

    private DateTime availabilityDate = DateTime.Today;
    private HashSet<int> bookedHoursForDay = [];
    private HashSet<int> unavailableHoursForDay = [];

    private DateTime selectedDate = DateTime.Today;
    private string viewMode = "Day";

    private static readonly int[] AvailabilityHours = [9, 10, 11, 12, 13, 14, 15, 16, 17];

    private DateTime WeekStart => selectedDate.AddDays(-(int)selectedDate.DayOfWeek);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email))
        {
            return;
        }

        provider = await Db.Users.FirstOrDefaultAsync(u => u.Email == email);
        if (provider is null)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var rangeStart = WeekStart;
        var rangeEnd = rangeStart.AddDays(7);

        var appointments = await Db.Appointments
            .Where(a => a.ProviderId == provider!.Id && a.StartTime >= rangeStart && a.StartTime < rangeEnd)
            .OrderBy(a => a.StartTime)
            .ToListAsync();

        var users = await Db.Users.ToDictionaryAsync(u => u.Id);
        var services = await Db.Services.ToDictionaryAsync(s => s.Id);

        weekAppointments = appointments
            .Select(a => new BookingRow(a, users.GetValueOrDefault(a.ClientId), services.GetValueOrDefault(a.ServiceId)))
            .ToList();

        await LoadMissingWaiversAsync();
        await LoadHealthFlagsAsync();

        // US-402: availability grid tracks whichever day is currently selected, not just today
        availabilityDate = selectedDate;

        bookedHoursForDay = (await Db.Appointments
            .Where(a => a.ProviderId == provider!.Id && a.StartTime.Date == availabilityDate)
            .Select(a => a.StartTime.Hour)
            .ToListAsync())
            .ToHashSet();

        unavailableHoursForDay = (await Db.ProviderAvailabilities
            .Where(a => a.ProviderId == provider!.Id && a.Date == availabilityDate && !a.IsAvailable)
            .Select(a => a.Hour)
            .ToListAsync())
            .ToHashSet();
    }

    // US-405: flag appointments whose service requires a waiver type the client hasn't signed
    private async Task LoadMissingWaiversAsync()
    {
        var requiredByAppointment = weekAppointments
            .Where(r => r.Client is not null && !string.IsNullOrEmpty(r.Service?.RequiresWaiverType))
            .ToList();

        if (requiredByAppointment.Count == 0)
        {
            missingWaiverAppointmentIds = [];
            return;
        }

        var clientIds = requiredByAppointment.Select(r => r.Client!.Id).ToHashSet();
        var signedWaivers = await Db.Waivers
            .Where(w => w.IsSigned && clientIds.Contains(w.ClientId))
            .Select(w => new { w.ClientId, w.WaiverType })
            .ToListAsync();
        var signedSet = signedWaivers.Select(w => (w.ClientId, w.WaiverType)).ToHashSet();

        missingWaiverAppointmentIds = requiredByAppointment
            .Where(r => !signedSet.Contains((r.Client!.Id, r.Service!.RequiresWaiverType!)))
            .Select(r => r.Appointment.Id)
            .ToHashSet();
    }

    // US-503: surface active health flags for clients on the provider's schedule
    private async Task LoadHealthFlagsAsync()
    {
        var clientIds = weekAppointments
            .Where(r => r.Client is not null)
            .Select(r => r.Client!.Id)
            .ToHashSet();

        if (clientIds.Count == 0)
        {
            healthFlagsByClient = [];
            return;
        }

        var flags = await Db.ClientHealthFlags
            .Where(f => f.IsActive && clientIds.Contains(f.ClientId))
            .ToListAsync();

        healthFlagsByClient = flags
            .GroupBy(f => f.ClientId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    // US-401, US-501, US-601: appointments on the provider's schedule for a given day (used by both Day and Week views)
    private IEnumerable<BookingRow> DaySchedule(DateTime day) =>
        weekAppointments.Where(r => r.Appointment.StartTime.Date == day.Date).OrderBy(r => r.Appointment.StartTime);

    // US-401, US-501, US-601: switch between daily and weekly schedule view
    private async Task SetViewMode(string mode)
    {
        viewMode = mode;
        await LoadAsync();
    }

    // US-401, US-501, US-601: navigate the schedule view backward by a day or week
    private async Task GoToPrevious()
    {
        selectedDate = viewMode == "Day" ? selectedDate.AddDays(-1) : selectedDate.AddDays(-7);
        await LoadAsync();
    }

    // US-401, US-501, US-601: navigate the schedule view forward by a day or week
    private async Task GoToNext()
    {
        selectedDate = viewMode == "Day" ? selectedDate.AddDays(1) : selectedDate.AddDays(7);
        await LoadAsync();
    }

    private async Task GoToToday()
    {
        selectedDate = DateTime.Today;
        await LoadAsync();
    }

    private async Task CompleteAppointment(Appointment appointment)
    {
        appointment.Status = "Completed";
        Db.Appointments.Update(appointment);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    // US-402: block off (or re-open) a specific hour on the currently selected day
    private async Task ToggleAvailability(int hour)
    {
        var existing = await Db.ProviderAvailabilities
            .FirstOrDefaultAsync(a => a.ProviderId == provider!.Id && a.Date == availabilityDate && a.Hour == hour);

        if (existing is not null)
        {
            Db.ProviderAvailabilities.Remove(existing);
        }
        else
        {
            Db.ProviderAvailabilities.Add(new ProviderAvailability
            {
                ProviderId = provider!.Id,
                Date = availabilityDate,
                Hour = hour,
                IsAvailable = false,
            });
        }

        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private static string FormatHour(int hour) => new DateTime(1, 1, 1, hour, 0, 0).ToString("h tt");

    // US-403, US-502: link to the client's notes (view existing notes / add a new one) from their appointment row
    private static string NoteLink(BookingRow row) =>
        $"/admin/service-notes?clientId={row.Client!.Id}&appointmentId={row.Appointment.Id}";

    private record BookingRow(Appointment Appointment, User? Client, Service? Service);
}
