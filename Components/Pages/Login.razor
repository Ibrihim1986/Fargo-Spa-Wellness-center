@page "/login"

<PageTitle>Login - Fargo Spa and Wellness</PageTitle>

<h1>Login</h1>

@if (HttpContext?.Request.Query.ContainsKey("error") == true)
{
    <p class="text-danger">Invalid email or password.</p>
}

@if (HttpContext?.Request.Query.ContainsKey("registered") == true)
{
    <p class="text-teal">Account created successfully. You can now log in.</p>
}

<div class="card" style="max-width: 28rem;">
    <div class="card-body">
        <form action="account/login" method="post">
            <AntiforgeryToken />
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" type="email" id="email" name="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input class="form-control" type="password" id="password" name="password" required />
            </div>
            <button class="btn btn-primary" type="submit">Log in</button>
        </form>
    </div>
</div>

<p class="mt-3">Don't have an account? <a href="register">Register</a></p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
