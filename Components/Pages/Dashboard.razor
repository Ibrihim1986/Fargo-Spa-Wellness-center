@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<!-- US-707: view past appointments and treatment history -->
<!-- US-704: reschedule or cancel an appointment online -->
<PageTitle>Dashboard - Fargo Spa and Wellness</PageTitle>

<h1>Dashboard</h1>

@if (currentUser is null)
{
    <p>Loading...</p>
}
else
{
    <h2 class="h5">Upcoming Appointments</h2>
    @if (upcomingAppointments.Count == 0)
    {
        <p class="text-sage">No upcoming appointments. <a href="/book">Book one now</a>.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-4">
            @foreach (var row in upcomingAppointments)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <div class="booking-time">
                                <div class="fw-semibold">@row.Appointment.StartTime.ToString("MMM d, h:mm tt")</div>
                                <span class="status-badge">@row.Appointment.Status</span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@row.Service?.Name</div>
                                <div class="text-sage small">with @(row.Provider?.FullName ?? "any available provider")</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartReschedule(row.Appointment)">Reschedule</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelAppointment(row.Appointment)">Cancel</button>
                            </div>
                        </div>

                        @if (reschedulingAppointmentId == row.Appointment.Id)
                        {
                            <div class="mt-3 pt-3 border-top">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <label class="form-label mb-0">New date</label>
                                    <input type="date" class="form-control w-auto" @bind="rescheduleDate" @bind:format="yyyy-MM-dd" @bind:after="RefreshRescheduleHoursAsync" />
                                </div>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @foreach (var hour in AvailabilityHours)
                                    {
                                        var isTaken = row.Appointment.ProviderId.HasValue && rescheduleTakenHours.Contains(hour);
                                        <button class="btn btn-sm @(rescheduleHour == hour ? "btn-primary" : "btn-outline-secondary")"
                                                disabled="@isTaken"
                                                @onclick="() => rescheduleHour = hour">
                                            @FormatHour(hour)
                                        </button>
                                    }
                                </div>
                                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="CancelReschedule">Cancel</button>
                                <button class="btn btn-sm btn-primary" disabled="@(rescheduleHour == 0)" @onclick="() => ConfirmRescheduleAsync(row.Appointment)">Confirm New Time</button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="h5">Past Appointments</h2>
    @if (pastAppointments.Count == 0)
    {
        <p class="text-sage">No past appointments yet.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var row in pastAppointments)
            {
                <div class="card">
                    <div class="card-body d-flex flex-wrap align-items-center gap-3">
                        <div class="booking-time">
                            <div class="fw-semibold">@row.Appointment.StartTime.ToString("MMM d, yyyy")</div>
                            <span class="status-badge">@row.Appointment.Status</span>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@row.Service?.Name</div>
                            <div class="text-sage small">with @(row.Provider?.FullName ?? "an available provider")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private User? currentUser;
    private List<BookingRow> upcomingAppointments = [];
    private List<BookingRow> pastAppointments = [];

    private int reschedulingAppointmentId;
    private DateTime rescheduleDate = DateTime.Today.AddDays(1);
    private int rescheduleHour;
    private HashSet<int> rescheduleTakenHours = [];

    private static readonly int[] AvailabilityHours = [9, 10, 11, 12, 13, 14, 15, 16, 17];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
        if (!string.IsNullOrEmpty(email))
        {
            currentUser = await Db.Users.FirstOrDefaultAsync(u => u.Email == email);
        }

        if (currentUser is not null)
        {
            await LoadAppointmentsAsync();
        }
    }

    private async Task LoadAppointmentsAsync()
    {
        var appointments = await Db.Appointments
            .Where(a => a.ClientId == currentUser!.Id)
            .ToListAsync();

        var services = await Db.Services.ToDictionaryAsync(s => s.Id);
        var providers = await Db.Users.ToDictionaryAsync(u => u.Id);

        var rows = appointments
            .Select(a => new BookingRow(a, services.GetValueOrDefault(a.ServiceId), a.ProviderId.HasValue ? providers.GetValueOrDefault(a.ProviderId.Value) : null))
            .ToList();

        // US-707: split into upcoming (still actionable) vs past/treatment history, most-recent-first for history
        upcomingAppointments = rows
            .Where(r => r.Appointment.Status is "Upcoming" or "CheckedIn")
            .OrderBy(r => r.Appointment.StartTime)
            .ToList();

        pastAppointments = rows
            .Where(r => r.Appointment.Status is "Completed" or "NoShow" or "Cancelled")
            .OrderByDescending(r => r.Appointment.StartTime)
            .ToList();
    }

    // US-704: cancel an appointment online
    private async Task CancelAppointment(Appointment appointment)
    {
        appointment.Status = "Cancelled";
        Db.Appointments.Update(appointment);
        await Db.SaveChangesAsync();
        await LoadAppointmentsAsync();
    }

    // US-704: open the inline reschedule picker for an appointment
    private async Task StartReschedule(Appointment appointment)
    {
        reschedulingAppointmentId = appointment.Id;
        rescheduleDate = appointment.StartTime.Date;
        rescheduleHour = 0;
        await RefreshRescheduleHoursAsync();
    }

    private void CancelReschedule()
    {
        reschedulingAppointmentId = 0;
        rescheduleHour = 0;
    }

    private async Task RefreshRescheduleHoursAsync()
    {
        rescheduleHour = 0;

        var appointment = upcomingAppointments.FirstOrDefault(r => r.Appointment.Id == reschedulingAppointmentId)?.Appointment;
        if (appointment?.ProviderId is not int providerId)
        {
            rescheduleTakenHours = [];
            return;
        }

        var booked = await Db.Appointments
            .Where(a => a.ProviderId == providerId && a.Id != appointment.Id
                && a.StartTime.Date == rescheduleDate.Date && a.Status != "Cancelled")
            .Select(a => a.StartTime.Hour)
            .ToListAsync();

        var blocked = await Db.ProviderAvailabilities
            .Where(a => a.ProviderId == providerId && a.Date == rescheduleDate.Date && !a.IsAvailable)
            .Select(a => a.Hour)
            .ToListAsync();

        rescheduleTakenHours = booked.Concat(blocked).ToHashSet();
    }

    // US-704: apply the new date/time to an existing appointment
    private async Task ConfirmRescheduleAsync(Appointment appointment)
    {
        if (rescheduleHour == 0)
        {
            return;
        }

        var duration = appointment.EndTime - appointment.StartTime;
        appointment.StartTime = rescheduleDate.Date.AddHours(rescheduleHour);
        appointment.EndTime = appointment.StartTime.Add(duration);
        Db.Appointments.Update(appointment);
        await Db.SaveChangesAsync();

        reschedulingAppointmentId = 0;
        await LoadAppointmentsAsync();
    }

    private static string FormatHour(int hour) => new DateTime(1, 1, 1, hour, 0, 0).ToString("h tt");

    private record BookingRow(Appointment Appointment, Service? Service, User? Provider);
}
