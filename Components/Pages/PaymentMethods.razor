@page "/payment-methods"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<!-- US-709: manage saved payment methods -->
<PageTitle>Payment Methods - Fargo Spa and Wellness</PageTitle>

<h1>Payment Methods</h1>

@if (cards is null)
{
    <p>Loading...</p>
}
else if (!cards.Any())
{
    <p class="text-sage">You don't have any saved cards yet. Cards can be saved during checkout.</p>
}
else
{
    <div class="d-flex flex-column gap-2" style="max-width: 32rem;">
        @foreach (var card in cards)
        {
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>@card.Brand ending in @card.Last4 <span class="text-sage small">(exp @card.ExpiryMonth/@card.ExpiryYear)</span></div>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCard(card)">Remove</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private User? currentUser;
    private List<SavedCard>? cards;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idClaim is null || !int.TryParse(idClaim, out var userId)) return;

        currentUser = await Db.Users.FindAsync(userId);
        if (currentUser is null) return;

        cards = await Db.SavedCards.Where(c => c.UserId == currentUser.Id).ToListAsync();
    }

    private async Task RemoveCard(SavedCard card)
    {
        Db.SavedCards.Remove(card);
        await Db.SaveChangesAsync();
        cards = cards!.Where(c => c.Id != card.Id).ToList();
    }
}
